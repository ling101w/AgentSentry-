{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentry.dev/schemas/agentdojo-native-audit-v1.json",
  "title": "AgentSentry AgentDojo native three-layer audit public aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "protocol", "visibility", "scope", "layers", "definitions", "runs", "interpretation"],
  "properties": {
    "$schema": { "const": "https://agentsentry.dev/schemas/agentdojo-native-audit-v1.json" },
    "protocol": {
      "const": { "name": "agentsentry.agentdojo.native-eval", "version": "2.0.0" }
    },
    "visibility": { "const": "public_aggregate" },
    "scope": { "const": "attack_trials" },
    "layers": {
      "const": [
        "official_agentdojo_asr",
        "normalized_exact_sink_match",
        "executed_malicious_side_effect_incidence"
      ]
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_agentdojo_asr", "normalized_exact_sink_match", "executed_malicious_side_effect_incidence"],
      "properties": {
        "official_agentdojo_asr": { "type": "string", "minLength": 1 },
        "normalized_exact_sink_match": { "type": "string", "minLength": 1 },
        "executed_malicious_side_effect_incidence": { "type": "string", "minLength": 1 }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    },
    "interpretation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "value": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "arm", "run_id", "source", "metrics", "diagnostics"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "arm": { "enum": ["agentsentry", "no-defense"] },
        "run_id": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_commit", "selection_sha256", "detector_transcript_sha256", "labels_sha256", "trials_sha256"],
          "properties": {
            "release_commit": { "$ref": "#/$defs/commit" },
            "selection_sha256": { "$ref": "#/$defs/sha256" },
            "detector_transcript_sha256": { "$ref": "#/$defs/sha256" },
            "labels_sha256": { "$ref": "#/$defs/sha256" },
            "trials_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_agentdojo_asr", "normalized_exact_sink_match", "executed_malicious_side_effect_incidence"],
          "properties": {
            "official_agentdojo_asr": { "$ref": "#/$defs/metric" },
            "normalized_exact_sink_match": { "$ref": "#/$defs/metric" },
            "executed_malicious_side_effect_incidence": { "$ref": "#/$defs/metric" }
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scorer_miss_trials", "official_success_without_detected_effect", "email_read_state_mutation_trials", "email_read_state_mutation_calls", "blocked_danger_trials", "observe_policy_deny_danger_trials"],
          "properties": {
            "scorer_miss_trials": { "type": "integer", "minimum": 0 },
            "official_success_without_detected_effect": { "type": "integer", "minimum": 0 },
            "email_read_state_mutation_trials": { "type": "integer", "minimum": 0 },
            "email_read_state_mutation_calls": { "type": "integer", "minimum": 0 },
            "blocked_danger_trials": { "type": "integer", "minimum": 0 },
            "observe_policy_deny_danger_trials": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
