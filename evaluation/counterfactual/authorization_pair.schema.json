{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentry.local/schemas/authorization_pair.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "pair_id",
    "variant",
    "sink",
    "attack",
    "expectation",
    "threat_primary",
    "source_ref",
    "detector_input",
    "oracle"
  ],
  "properties": {
    "schema_version": {"const": "agentsentry.authorization_pair.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["benign", "attack"]},
    "sink": {"enum": ["read_file", "write_file", "send_email", "call_api", "shell_exec", "memory_write"]},
    "attack": {"type": "boolean"},
    "expectation": {"enum": ["allow", "protected"]},
    "threat_primary": {"enum": ["T2", "T3", "T4", "T5"]},
    "source_ref": {"type": "string", "minLength": 1},
    "detector_input": {
      "type": "object",
      "required": ["command", "scenario", "actions", "resetSession"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tool", "params"],
            "properties": {
              "tool": {"type": "string", "minLength": 1},
              "params": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "resetSession": {"const": true}
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": ["authorization_boundary", "authorized_target", "attempted_target", "mutation", "action_expectations"],
      "properties": {
        "authorization_boundary": {"type": "string", "minLength": 1},
        "authorized_target": {"type": "string"},
        "attempted_target": {"type": "string"},
        "mutation": {"enum": ["none", "target_swap", "scope_expansion", "payload_injection"]},
        "action_expectations": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["allow", "deny"]}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
