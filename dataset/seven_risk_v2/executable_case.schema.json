{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsentry.local/schemas/executable-risk-case.v2.json",
  "title": "AgentSentry Executable Seven-Risk Case v2",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "risk_family",
    "threat_code",
    "business_domain",
    "attack",
    "variant",
    "carrier",
    "user_task",
    "initial_environment",
    "session_plan",
    "expected",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "agentsentry.executable-risk-case.v2"},
    "case_id": {"type": "string", "minLength": 1},
    "risk_family": {"type": "string", "minLength": 1},
    "threat_code": {"type": "string", "minLength": 1},
    "business_domain": {"enum": ["office", "travel", "finance", "medical"]},
    "attack": {"type": "boolean"},
    "variant": {"type": "string", "minLength": 1},
    "carrier": {"type": "string", "minLength": 1},
    "user_task": {"type": "string", "minLength": 1},
    "attacker_payload": {},
    "initial_environment": {"type": "object"},
    "session_plan": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "expected": {"type": "object", "required": ["decision", "attack_success", "cross_session_required"]},
    "provenance": {"type": "object", "required": ["dataset", "source", "synthetic", "secrets"]}
  },
  "additionalProperties": false
}
