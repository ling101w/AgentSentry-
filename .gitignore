# Python / local environments
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
*.pyc
*.pyo

# Node / frontend builds
node_modules/
dist/
build/
coverage/

# Local tools and browser automation state
.playwright-mcp/
.cache/
.tmp/
tmp/

# Secrets and local runtime state
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
*.db
*.sqlite
*.sqlite3
*.pid
*.log
*.jsonl
*.local.json
runtime/*
!runtime/README.md
runtime/agentdojo/
.openclaw/

# Evaluation fixtures are versioned; the real independent holdout stays sealed.
!evaluation/**/*.jsonl
evaluation/blind/blind_holdout*.jsonl
!evaluation/blind/blind_holdout.example.jsonl
evaluation/native/*.private.jsonl
evaluation/native/*.private.json

# OpenClaw local workspace may contain credentials and machine-local state.
openclaw-workspace/

# External research repos are large and not required for runtime deployment.
AgentWard-main/
AgentWard-main.zip
third_party/benchmarks/*
!third_party/benchmarks/README.md

# Generated frontend alternates kept out of source control.
src/agentsentry/static/security-screen.css
src/agentsentry/static/security-screen.js

# Generated reports and one-off artifacts.
reports/**/*.png
reports/**/*.docx
reports/benchmark_eval/
reports/tool_attack_benchmark/
reports/full_acceptance/full_acceptance_report_*.md
reports/full_acceptance/full_acceptance_results_*.json
reports/supervision_ablation/baseline-escaped-writes/
reports/supervision_ablation/*-outbox.jsonl
reports/supervision_ablation/*-shell-exec.jsonl
reports/supervision_ablation/*-memory.json
reports/supervision_ablation/*-sensitive-read.jsonl
reports/blind_evaluation/*.private.json
reports/native_agentdojo/*.private.*
reports/plugin_comparison/*.json
reports/plugin_comparison/*.txt
reports/plugin_comparison/custom_*/
reports/e2e_plugin_comparison/
openclaw-plugin/sbom.cdx.json
atbeach-new/runtime/
atbench/runtime/
atbench/reports/atbench_smoke_diagnosis/
atbench/third_party/benchmarks/
ATBench-*.zip
atbench_p0_metric_semantics_refined.zip

# Output keeps the README and compressed deliverables, not expanded build trees.
output/*
!output/README.md
!output/*.tar.gz

# Local dashboard runs and packaged plugin builds.
artifacts/dashboard-*
openclaw-plugin/openclaw-plugin.zip

# xuanjian-2.0: synthetic sets are regenerable (data/synthetic/generate_v2.py).
xuanjian-2.0/data/synthetic/*.json
xuanjian-2.0/data/synthetic/*.png
xuanjian-2.0/data/synthetic_*/
# Real-session evidence packs contain live credentials from the user's own
# research sessions; keep them local. Replay attack packs are safe to share.
xuanjian-2.0/data/annotation/evidence/*.md
xuanjian-2.0/data/replay/*.bak
xuanjian-2.0/data/replay/*.log
xuanjian-2.0/data/replay/*.pid
xuanjian-2.0/wsl_temp_check.txt
# Human annotation results are versioned despite the global *.jsonl rule.
!xuanjian-2.0/data/annotation/annotations.v*.jsonl
!xuanjian-2.0/data/annotation/evidence_manifest.jsonl
