{
  "profile": "observe",
  "enforcement": { "mode": "observe" },
  "semantic": {
    "enabled": false,
    "mode": "risk-tiered",
    "judgeToolCalls": true,
    "judgeMessages": false,
    "judgeProvenance": false,
    "judgeMemoryWrites": true
  },
  "policy": {
    "deterministic": true,
    "taintFeedback": true,
    "restrictWritesToAllowedRoots": false,
    "allowedWriteRoots": []
  },
  "runtimeIsolation": {
    "requireKernelObserverForHighRisk": false,
    "unavailableAction": "require_approval",
    "auditAfterExecution": true,
    "requireNetworkNamespaceForShell": false
  },
  "responseCover": { "enabled": false, "coverAssistantAfterContamination": true },
  "notifications": { "enableProactiveNotifications": false, "minSeverity": "danger" },
  "dynamicSecurity": { "enabled": true, "windowSize": 12, "riskThreshold": 65, "recoverAfterSafeActions": 6, "maxDegradationLevel": 3 },
  "capabilityTokens": { "enabled": true, "ttlMs": 600000, "maxInvocations": 5 },
  "rollback": { "enabled": true, "maxSnapshots": 80, "protectedPaths": ["MEMORY.md", "User.md", "Soul.md", "openclaw.json", ".openclaw/openclaw.json"] },
  "initializationDefense": { "enabled": true, "scanGlobalOpenClaw": true, "maxComponents": 200 },
  "externalPolicy": { "enabled": true, "requireAuth": true },
  "multiAgentSecurity": { "enabled": true, "requireIdentity": true, "requireSignedEnvelope": true, "maxEnvelopeTtlMs": 600000 }
}
